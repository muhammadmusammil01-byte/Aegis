# Database - PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexushub
DB_USER=postgres
DB_PASSWORD=postgres

# Server
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Security & Authentication
JWT_SECRET=nexushub-jwt-secret-change-in-production
JWT_EXPIRES_IN=24h
SESSION_SECRET=nexushub-session-secret-change-in-production

# Gemini AI API (for AI Debugger)
GEMINI_API_KEY=your_gemini_api_key_here

# WebSocket
CLIENT_URL=http://localhost:3000
